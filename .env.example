# Copia este archivo a ".env" y pega tu clave de OpenRouter.
# Consíguela en: https://openrouter.ai/settings/keys  (requiere saldo/créditos)
OPENROUTER_API_KEY=pega_aqui_tu_clave

# Opcional:
# OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.0-mini
# OPENROUTER_LLM_MODEL=google/gemini-2.5-flash
# OPENROUTER_TTS_MODEL=deepgram/aura-2
# OPENROUTER_TTS_VOICE=aura-2-alvaro-es   (masculina, español latinoamericano)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_REFERER=https://tu-app.example.com   (atribución opcional para OpenRouter)
# OPENROUTER_TITLE=TresClips
